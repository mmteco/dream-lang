def test_tuple2():
    let t = (10, 20)
    print(t[0])
    print(t[1])

def test_tuple3():
    let t = (1, 2, 3)
    print(t[0])
    print(t[1])
    print(t[2])

def test_tuple5():
    let t = (10, 20, 30, 40, 50)
    print(t[0])
    print(t[1])
    print(t[2])
    print(t[3])
    print(t[4])

test_tuple2()
test_tuple3()
test_tuple5()
