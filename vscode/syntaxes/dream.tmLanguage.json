{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dream",
  "scopeName": "source.dream",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dream",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dream",
          "match": "\\b(if|else|elif|while|for|in|match|case|return|break|continue|async|await)\\b"
        },
        {
          "name": "keyword.other.dream",
          "match": "\\b(let|def|struct|interface|impl|implements|enum|type|const|import|from|as)\\b"
        },
        {
          "name": "keyword.operator.logical.dream",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.dream",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dream",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.dream",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        },
        {
          "name": "string.quoted.single.dream",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.dream",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.dream",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.dream",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.dream",
          "match": "\\b(int|float|str|bool|bytes|list|dict|tuple|None)\\b"
        },
        {
          "name": "support.type.option.dream",
          "match": "\\b(Option|Some|Result|Ok|Err)\\b"
        },
        {
          "name": "entity.name.type.dream",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.dream",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.dream",
          "match": "\\b(print|len|range|map|filter|reduce)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.dream",
          "match": "\\+|\\-|\\*|\\/|%"
        },
        {
          "name": "keyword.operator.comparison.dream",
          "match": "==|!=|<|>|<=|>="
        },
        {
          "name": "keyword.operator.assignment.dream",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.dream",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.pipe.dream",
          "match": "\\|"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.dream",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.dream",
          "match": "\\bNone\\b"
        }
      ]
    }
  }
}
